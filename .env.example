# Recall key and regional API URL must belong to the same workspace.
RECALL_API_KEY=
RECALL_API_BASE_URL=https://us-east-1.recall.ai/api/v1

# Save your xAI API key in Recall Dashboard > Agents > Grok.
# Recall connects to Grok directly; this app does not need the xAI key.
GROK_VOICE=ara

# HTTPS origin tunneling ONLY the MCP server on localhost:7864.
# Keep the meeting launcher on localhost:8004 local.
GROK_PUBLIC_URL=

# Stop the demo bot and expire its tool access after this many seconds.
SESSION_TIMEOUT_SECONDS=600
